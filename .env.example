# Copy this file to .env (same directory, project root) and fill in
# real values. .env is gitignored -- never commit real credentials.

# AQICN (aqicn.org) -- World Air Quality Index API. Free tier token,
# register at https://aqicn.org/data-platform/token/ (takes ~1 minute,
# no approval wait). Without this, the AQICN supplemental source will
# report "not configured" instead of real air-quality data -- NWS,
# USGS/river-gauge, and Iowa DOT sources all work with NO key at all,
# so the app still runs and demos fine without this if you're in a
# hurry; AQICN just won't show real numbers until it's set.
AQICN_API_TOKEN=
